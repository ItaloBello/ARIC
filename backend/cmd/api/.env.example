API_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=aric
DB_SSLMODE=disable

# Gere um segredo forte, ex.: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRACAO_HORAS=24

VIACEP_URL=https://viacep.com.br/ws/

# Fechamento semanal das ligas dentro da API (padrão). "off" para usar o cron do servidor.
LIGAS_JOB=on

# IPs dos proxies (Apache) em quem confiar para ler o IP real do cliente. Padrão: 127.0.0.1,::1
TRUSTED_PROXIES=127.0.0.1,::1
